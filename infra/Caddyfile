# Servido de las dos SPA en Railway.
#
# Railway inyecta $PORT y espera que el proceso escuche ahí.

{
	# Caddy abre por defecto una API de administración interna en :2019, además
	# del sitio. Railway detecta los puertos abiertos del contenedor y puede
	# terminar generando el dominio público sobre ese 2019 en vez del sitio
	# real. No la necesitamos: es un solo archivo estático servido, sin
	# reconfiguración en caliente.
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd

	# Sin esto, recargar sobre /tienda/orden/abc devuelve 404: esas rutas no
	# son archivos, las resuelve el router en el navegador. try_files manda
	# cualquier ruta desconocida al index y deja que React decida.
	try_files {path} /index.html
	file_server

	# Los assets llevan hash en el nombre: se cachean para siempre. Todo lo
	# demás va con no-cache, y la regla se escribe al revés a propósito. Listar
	# los archivos "volátiles" uno por uno dejaba afuera las rutas de la SPA
	# —/inventario, /tienda/orden/x— que try_files sirve como index.html: el
	# matcher compara la ruta pedida, no el archivo entregado. Así, entrar por
	# un link directo dejaba la app vieja pegada.
	@inmutables path /assets/*
	header @inmutables Cache-Control "public, max-age=31536000, immutable"

	@resto not path /assets/*
	header @resto Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# La app se instala como PWA y no se embebe en ningún lado.
		X-Frame-Options DENY

		# Railway termina TLS por delante: forzamos HTTPS por un año. Sin
		# `preload` a propósito — eso es un compromiso que se envía a la lista
		# del navegador y no se revierte rápido.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Nada de esto usa la app; apagarlo reduce la superficie.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

		# CSP de línea de base. `script-src` deja `'unsafe-inline'` porque el
		# registro del service worker y el preload de módulos de Vite inyectan
		# scripts inline; endurecerlo (hashes, quitar unsafe-inline) es un
		# pendiente para después de verificar en el navegador. Lo que sí acota
		# ya: a dónde puede conectarse y embeberse la app, y de dónde carga
		# imágenes. `*.supabase.co` cubre REST, Realtime (wss), Storage y las
		# Edge Functions sin tener que hornear el ref del proyecto acá.
		Content-Security-Policy "default-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob: https://*.supabase.co; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
	}
}
