# Secretos de las Edge Functions. Copiar a .env para desarrollo local.
#
# En producción se cargan con:
#   supabase secrets set --env-file supabase/functions/.env
#
# La clave privada VAPID NO va al repo ni al bundle del cliente. Sólo la
# pública viaja al navegador, como VITE_VAPID_PUBLIC_KEY.
#
# Generar un par nuevo:
#   node -e "const{generateKeyPairSync}=require('crypto');const{publicKey,privateKey}=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const b=x=>x.toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');console.log('pub',b(publicKey.export({type:'spki',format:'der'}).subarray(-65)));console.log('priv',b(privateKey.export({type:'pkcs8',format:'der'}).subarray(36,68)))"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@ojosdecielo.com

# Impide que cualquiera dispare el envío masivo desde afuera.
SECRETO_CRON=

# Adónde vuelve quien acepta una invitación al equipo.
URL_PANEL=http://localhost:5174

# MercadoPago. Sin estas credenciales el checkout online no funciona.
# El access token sale del panel de MercadoPago (Tus integraciones → Credenciales).
# El secreto del webhook se configura al dar de alta la notificación.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
URL_APP=http://localhost:5173
